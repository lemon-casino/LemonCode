node_modules/
dist/
# lcode-server-cli 发行包 staging 输出，本地组装产物不入库。
dist-release/
# macOS CI 按架构隔离 electron-builder 输出目录，这些仍是构建产物。
packages/desktop/dist-*/
out/
prebuilds/
bundled-resources/
mock-cdn/
packages/desktop/bundled-resources/
packages/desktop/bundled-agents/
packages/desktop/bundled-tools/
packages/desktop/mock-cdn/
*.tsbuildinfo
.DS_Store
coverage/
.env.local
.env.*.local
.env
.VSCodeCounter
.idea/
.zed/
.cache
# CI 会跨任务保留这些下载缓存；不应进入 Git 未跟踪源码枚举。
/.electron-builder-cache/
/.electron-cache/
/.pnpm-store/
/.npm-cache/
.turbo/
z-work/
openclaw/
.run-logs/
.worktrees/
packages/stream-animate/dist-server/
packages/stream-animate/.stream-animate-data/
.codegraph
.mimosa/
# 集成分支曾混入 node-gyp 构建产物与 .playwright-mcp 临时快照；
# 入库由 scripts/ci/ci-repo-hygiene.mjs 在 CI 第一站拒绝，这里让本地 git add 也忽略它们。
.playwright-mcp/
*.o
.deps/
obj.target/
config.gypi
gyp-mac-tool
*.target.mk
binding.Makefile
# 这两条原来写成 build/Makefile、build/Release/*.node，含中间斜杠的 pattern
# 只相对 .gitignore 所在目录（仓库根）生效，匹配不到 packages/ax-macos/build/ 下的产物；
# 而 ci-repo-hygiene.mjs 的 denylist 用的是 (^|/)build/... 任意层级匹配。
# 宽严不一致时无斜杠 pattern 能拦住的产物会被 git add -A 重新扫进索引。
# 加 **/ 让忽略范围与门禁范围对齐。
**/build/Makefile
**/build/Release/*.node

# CUA 权限浮窗吸附用的 Swift 辅助二进制（由 prepare:macos-window-bounds 从
# packages/desktop/native/macos-window-bounds/main.swift 编出，源码入库、产物不入库）
packages/desktop/resources/macos-window-bounds/
# CUA Helper SEA 基座下载缓存（scripts/cua-helper-sea-base.mjs 落盘的官方 Node 22 运行时，纯下载产物）
/.tmp/
# Python 字节码（docker/plugin-eval/summarize.py 在主机上跑会生成）。
__pycache__/
*.pyc

# 本地工具运行产物，均可再生：桌面端 e2e 的截图/缓存/网络抓包，以及桌面
# 开发运行器的 Electron 下载缓存。
packages/desktop/.e2e-artifacts/
packages/desktop/.e2e-cache/
packages/desktop/.e2e-network-capture/
.lcode-runtime/

# cfworker-remote 是独立 git 仓库(Cloudflare Workers 隧道),单独提交与部署。
cfworker-remote/

# 构建步骤误写入 src 的产物,不入库。
packages/desktop/src/scheduler/schedulerProtocol.d.ts
packages/desktop/src/scheduler/schedulerProtocol.d.ts.map
packages/desktop/src/scheduler/schedulerProtocol.js
packages/desktop/src/scheduler/schedulerProtocol.js.map

# Windows 保留设备名：POSIX shell 下 `2>NUL`（含引号写法）会落盘成普通文件，
# git 索引它时报 "short read" 使 `git add -A` 整体失败、阻断提交流程。
# Agent Bash 已在执行边界把裸/带引号的 nul 重定向归一化为 /dev/null
# （specs/agent-bash-nul-redirection.md）；这里再忽略任意层级残留实例作兜底
# （仓库无同名已跟踪文件，大小写两种命名都覆盖，避免 Linux 大小写敏感漏网）。
NUL
nul

# 品牌迁移一次性工具与运行时数据（工作流草稿/运行快照）不入库
.zcode/
.lcode/

