{
  "name": "@lcode/dynamic-workflow-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "pretypecheck": "pnpm --filter @lcode/dynamic-workflow build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../oxlint.config.json src --no-ignore",
    "lint:fix": "oxlint --config ../../oxlint.config.json --fix src --no-ignore"
  },
  "dependencies": {
    "@lcode/dynamic-workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
