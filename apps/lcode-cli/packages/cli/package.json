{
  "name": "@lcode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for lcode",
  "bin": {
    "lcode": "./dist/lcode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/lcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/lcode-cli run build --filter=!@lcode/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@lcode/adapters": "workspace:*",
    "@lcode/bootstrap": "workspace:*",
    "@lcode/contracts": "workspace:*",
    "@lcode/core": "workspace:*",
    "@lcode/dynamic-workflow-runtime": "workspace:*",
    "@lcode/i18n": "workspace:*",
    "@lcode/provider-node": "workspace:*",
    "@lcode/shared": "workspace:*",
    "@lcode/shared-types": "workspace:*",
    "@lcode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
