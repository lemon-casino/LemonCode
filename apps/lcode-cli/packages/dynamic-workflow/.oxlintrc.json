{
  // 本包自带的 oxlint 配置：必须显式存在，否则从仓库根运行 `pnpm --filter @lcode/dynamic-workflow lint`
  // 时配置自动发现会向上找到根 .oxlintrc.json，而根配置的 ignorePatterns 含 "apps/lcode-cli"，
  // 导致整个包 0 个文件可 lint、以 exit 1 失败。就近发现本文件后，规则仍通过 extends
  // 完整继承根配置，只有下方 ignorePatterns 是本包特有的差异。
  //
  // 分析测试的图体语料（顶层 return、顶层 for-await、裸 agent()）不是合法模块语法，
  // 在 ignorePatterns 统一排除——根 `pnpm lint` 与包内 lint 两个入口共用这一份豁免清单。
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../../.oxlintrc.json"],
  "ignorePatterns": [
    "tests/workflows/**",
    "tests/graphs/**",
    "tests/holes/**",
    "tests/schemas/**",
    "tests/schema-errors/**"
  ],
  // override 留空：文件超出 max-lines 上限时应拆模块，而不是回到这里加豁免名单。
  "overrides": []
}
