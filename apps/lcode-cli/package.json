{
  "name": "lcode-cli",
  "version": "0.16.9",
  "private": true,
  "description": "A cross-platform TypeScript Node.js CLI with a small TUI and optional SEA packaging.",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../.. exec turbo --skip-infer --cwd apps/lcode-cli run build",
    "build:sea": "pnpm --filter @lcode/cli build:sea",
    "bench:session-recall": "pnpm --filter @lcode/contracts build && pnpm --filter @lcode/adapters build && pnpm --filter @lcode/core build && node --import tsx packages/bootstrap/scripts/session-recall-benchmark.mjs",
    "check": "pnpm registry:check && pnpm typecheck",
    "clean": "pnpm --dir ../.. exec turbo --skip-infer --cwd apps/lcode-cli run clean",
    "cli:build": "pnpm --filter @lcode/cli build",
    "cli:dev": "pnpm --filter @lcode/cli dev",
    "cli:upload-sea": "pnpm --filter @lcode/cli upload:sea",
    "dev": "pnpm --filter @lcode/cli dev",
    "format": "oxfmt --write package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "format:check": "oxfmt --check package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "lint": "pnpm --dir ../.. exec turbo --skip-infer --cwd apps/lcode-cli run lint",
    "lint:count": "node scripts/count-ts-lines.mjs",
    "lint:fix": "pnpm --dir ../.. exec turbo --skip-infer --cwd apps/lcode-cli run lint:fix",
    "prompt-trajectory:model-io": "pnpm --filter @lcode/prompt-trajectory model-io --",
    "prompt-trajectory:prompt": "pnpm --filter @lcode/prompt-trajectory record:prompt --",
    "registry:check": "node scripts/generate-bash-command-registry.mjs --check",
    "registry:generate": "node scripts/generate-bash-command-registry.mjs",
    "registry:test": "node --test scripts/generate-bash-command-registry.test.mjs",
    "release": "node ../../node_modules/release-it/bin/release-it.js --config .release-it.json",
    "release:dry": "pnpm run release --release-version",
    "sea": "pnpm --filter @lcode/cli sea",
    "test:debug": "pnpm --dir ../.. --filter debug test",
    "typecheck": "pnpm --dir ../.. exec turbo --skip-infer --cwd apps/lcode-cli run typecheck"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "proxy-agent": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@withfig/autocomplete": "2.692.3",
    "c8": "^11.0.0",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.87.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "turbo": "^2.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@10.34.6"
}
