# 保持脚本文件 LF 换行，避免 Windows CRLF 导致 shebang 解析失败
*.mjs text eol=lf
*.sh  text eol=lf
*.patch text eol=lf
apps/lcode-cli/packages/core/src/tool/handlers/generated/bash-command-registry.ts text eol=lf

# 上游许可原文与生成的声明按字节保存，不能自动转换换行或裁剪空白。
# 原文中的 License / ======= 是 Markdown 标题，不是合并冲突。
THIRD-PARTY-NOTICES.md -text -whitespace conflict-marker-size=32 linguist-generated=true
third-party/upstream/** -text -whitespace
third-party/native-search/licenses/** -text -whitespace
third-party/runtime/*.txt -text -whitespace
# 修复：mise 许可漏出原文保护范围，Windows worktree 的 CRLF checkout 会破坏批准摘要。
third-party/mise/LICENSE.txt -text -whitespace
third-party/inventory.json linguist-generated=true

# OAuth协议适配和固定插件源码保留原始许可/源文件字节，避免Windows换行转换破坏manifest哈希。
packages/provider-node/src/provider-auth/native/LICENSE.magpie -text -whitespace
packages/provider-node/src/provider-auth/vendor/** -text -whitespace

# 品牌SVG按来源字节保留，避免Windows换行转换破坏素材记录和第三方快照哈希。
packages/ui/src/assets/provider-icons/model-provider-*.svg -text -whitespace
packages/desktop/assets/startup-media/*.mp4 -text -diff
# SHA-256 清单需要各平台 checkout 后的声明文件字节一致。
packages/desktop/assets/startup-media/*.md text eol=lf
packages/desktop/assets/startup-media/*.json text eol=lf
