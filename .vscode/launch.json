{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LCode Desktop: Main",
      "type": "pwa-node",
      "request": "attach",
      "port": 9231,
      "preLaunchTask": "lcode: start electron (debug)",
      "restart": true,
      "timeout": 30000,
      "outFiles": ["${workspaceFolder}/packages/desktop/out/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/desktop/out/**/*.js",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal"
    },
    {
      "name": "LCode Desktop: Main (with host inspect)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9231,
      "preLaunchTask": "lcode: start electron (debug with host inspect)",
      "restart": true,
      "timeout": 30000,
      "outFiles": ["${workspaceFolder}/packages/desktop/out/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/desktop/out/**/*.js",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "LCode Desktop: Renderer",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9229,
      "webRoot": "${workspaceFolder}/packages/desktop/src/renderer",
      "timeout": 30000
    },
    {
      "name": "LCode Desktop: Host",
      "type": "pwa-node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "timeout": 30000,
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/packages/desktop/out/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/desktop/out/**/*.js",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "LCode Desktop: F5",
      "configurations": ["LCode Desktop: Main", "LCode Desktop: Renderer"],
      "stopAll": true
    },
    {
      "name": "LCode Desktop: F5 (with host inspect)",
      "configurations": [
        "LCode Desktop: Main (with host inspect)",
        "LCode Desktop: Renderer",
        "LCode Desktop: Host"
      ],
      "stopAll": true
    }
  ]
}
