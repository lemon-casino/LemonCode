diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..af150b319573ee0211679b53bfb259f8502f7309
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,10 @@
+'use strict';
+
+// 修复 CVE-2026-93687：长度限制不能约束 AST 深度，统一限制所有递归入口，
+// 以可控的语法错误拒绝超深模式，避免调用栈耗尽。
+const MAX_AST_DEPTH = 256;
+module.exports = depth => {
+  if (depth > MAX_AST_DEPTH) {
+    throw new SyntaxError(`Brace pattern exceeds maximum nesting depth (${MAX_AST_DEPTH})`);
+  }
+};
